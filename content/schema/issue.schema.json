{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiv.local/schema/issue.json",
  "title": "Issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "title",
    "heroline",
    "dek",
    "tag",
    "briefMin",
    "readMin",
    "briefing",
    "keywords",
    "mainEvent",
    "keynums",
    "timeline",
    "intro",
    "analysis",
    "mood",
    "tips",
    "method"
  ],
  "properties": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 4 },
    "heroline": { "type": "string", "minLength": 4 },
    "dek": { "type": "string", "minLength": 12 },
    "tag": { "type": "string" },
    "briefMin": { "type": "integer", "minimum": 1, "maximum": 10 },
    "readMin": { "type": "integer", "minimum": 3, "maximum": 40 },
    "briefing": {
      "type": "array",
      "minItems": 4,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "headline", "summary"],
        "properties": {
          "id": { "type": "string" },
          "headline": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "mainEvent": { "type": "string" },
    "keynums": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["val", "lab", "sub"],
        "properties": {
          "val": { "type": "string" },
          "lab": { "type": "string" },
          "sub": { "type": "string" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "d"],
        "properties": {
          "t": { "type": "string" },
          "d": { "type": "string" }
        }
      }
    },
    "intro": { "type": "string" },
    "analysis": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "bullets", "body", "takeaway", "tags", "sources"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "body": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "extra": { "type": "string" },
          "takeaway": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["handle", "url", "kind"],
              "properties": {
                "handle": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "kind": { "enum": ["hot", "talk", "rt", "doc"] }
              }
            }
          }
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shift", "grow", "caution", "heat"],
      "properties": {
        "shift": { "type": "string" },
        "grow": { "type": "string" },
        "caution": { "type": "string" },
        "heat": { "type": "string" }
      }
    },
    "tips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body", "via"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "via": { "type": "string" }
        }
      }
    },
    "method": { "type": "string" }
  }
}
